---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import product from '../data/product.json';
const isDocs = Astro.url.pathname.startsWith('/docs');
---
<header class="site-header" x-data="siteHeader" @keydown.escape.window="closeMenu">
  <div class="container header-inner">
    <Logo />
    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="/#ferramentas">Ferramentas</a>
      <a href="/#como-funciona">Como funciona</a>
      <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Documentação</a>
    </nav>
    <div class="header-actions">
      <span class="platform"><Icon name="windows" size={14} /> Windows x64</span>
      <a class="button button-small button-dark" href={`/downloads/${product.filename}`} download aria-label="Baixar Verman para Windows"><span class="button-label-wide">Baixar Verman</span><span class="button-label-narrow">Baixar</span><Icon name="download" size={15} /></a>
      <button class="menu-toggle icon-button" @click="toggleMenu" :aria-expanded="open" aria-controls="mobile-menu" aria-label="Abrir menu"><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-nav" x-show="open" x-cloak aria-label="Navegação móvel">
    <a href="/#ferramentas" @click="closeMenu">Ferramentas </a>
    <a href="/#como-funciona" @click="closeMenu">Como funciona </a>
    <a href="/docs/" @click="closeMenu">Documentação </a>
    <a href={`/downloads/${product.filename}`} download>Baixar para Windows <Icon name="download" size={17}/></a>
  </nav>
</header>
